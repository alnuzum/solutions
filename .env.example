# Copy to .env (never commit it). Every value here is a placeholder.
POSTGRES_PASSWORD=change-me
# Comma-separated "key_id:base64(32 bytes)"; the first key encrypts, all keys decrypt.
# Generate: python -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
SECRET_KEYS=
# Bearer token for the internal /connections API; empty disables the API.
ADMIN_TOKEN=
