{
	email dev@alnuzum.com
	servers {
		protocols h1 h2
	}
}

# access log per site as JSON lines; the query string (OAuth codes), the Referer and the Telegram webhook
# secret never reach it, Cookie and Authorization are redacted by Caddy itself
(access) {
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" "?_"
				request>headers>Referer delete
				# the webhook secret of the Telegram bots comes in a header of its own
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
			}
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# the platform: hooks take at most 64 KB (no CRM and no Telegram update sends more: a voice note comes by
# getFile), an order, a voice note or a contract with its file (POST /{ru,en}/orders, /voice, /contracts,
# /contracts/standard/<id>) 9 MB
# (the file itself at most 8 MB), anything else 1 MB; the admin API (/connections) answers only from inside
# the server
(platform) {
	@hooks path /hooks/*
	request_body @hooks {
		max_size 64KB
	}
	@order {
		method POST
		path_regexp ^/(ru|en)/(orders|voice|contracts|contracts/standard/[0-9a-f-]+)$
	}
	request_body @order {
		max_size 9MB
	}
	@other {
		not path /hooks/*
		not {
			method POST
			path_regexp ^/(ru|en)/(orders|voice|contracts|contracts/standard/[0-9a-f-]+)$
		}
	}
	request_body @other {
		max_size 1MB
	}
	@admin path /connections /connections/*
	respond @admin 404
}

apps.alnuzum.com {
	import access prod
	import platform
	reverse_proxy platform-prod:8000
}

apps-stand.alnuzum.com {
	import access stand
	import platform
	reverse_proxy platform-stand:8000
}

# test Odoo Community for checking the Odoo connection through the interface
odoo-e2e.alnuzum.com {
	import access odoo
	reverse_proxy odoo:8069
}
